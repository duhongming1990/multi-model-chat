{
  "name": "@local/multi-model-chat",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "多模型对话：一次提问并发调用多个模型，保存每一组回答，逐条点赞并做模型点赞分析统计。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "scripts/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  }
}
