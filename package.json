{
  "name": "dsh-multi-model-chat",
  "version": "1.2.0",
  "type": "module",
  "description": "多模型对话：一次提问并发调用多个 OpenAI 兼容模型，保存每组回答，逐条点赞并做模型点赞分析统计。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "scripts/*.mjs",
    "docs",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "multi-model",
    "chat",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duhongming1990/multi-model-chat.git"
  },
  "homepage": "https://github.com/duhongming1990/multi-model-chat#readme",
  "bugs": {
    "url": "https://github.com/duhongming1990/multi-model-chat/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0"
  }
}
